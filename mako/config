font=JetBrainsMonoNL Nerd Font 11
background-color=#12241CC0
text-color=#E6F0EA
# Leaf glow border on notifications
border-color=#7AD4A0
border-size=2
border-radius=10
width=340
height=110
padding=12
margin=12
