font=JetBrainsMonoNL Nerd Font 11
background-color=#17211aC0
text-color=#ddf0e3
# Leaf glow border on notifications
border-color=#73d694
border-size=2
border-radius=10
width=340
height=110
padding=12
margin=12
default-timeout=5000

[urgency=low]
border-color=#73d69488
text-color=#ddf0e3

[urgency=normal]
border-color=#73d694

[urgency=high]
border-color=#E07070
text-color=#F5F3EE
default-timeout=8000

[mode=do-not-disturb]
invisible=1
